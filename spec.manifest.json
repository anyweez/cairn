  "tables": [
    {
      "name": "github.com/anyweez/cairn/examples/decisions.Lifecycle",
      "edges": [
        {
          "from": "",
          "on": "create",
          "to": "open"
        },
        {
          "from": "decided",
          "on": "set_status:open",
          "to": "open"
        },
        {
          "from": "decided",
          "on": "supersede",
          "to": "superseded"
        },
        {
          "from": "deferred",
          "on": "set_status:dropped",
          "to": "dropped"
        },
        {
          "from": "deferred",
          "on": "set_status:open",
          "to": "open"
        },
        {
          "from": "dropped",
          "on": "set_status:deferred",
          "to": "deferred"
        },
        {
          "from": "dropped",
          "on": "set_status:open",
          "to": "open"
        },
        {
          "from": "open",
          "on": "record_outcome",
          "to": "decided"
        },
        {
          "from": "open",
          "on": "set_status:deferred",
          "to": "deferred"
        },
        {
          "from": "open",
          "on": "set_status:dropped",
          "to": "dropped"
        },
        {
          "from": "superseded",
          "on": "set_status:open",
          "to": "open"
        }
      ]
    }
  ]
