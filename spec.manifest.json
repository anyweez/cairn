{
  "rules": [
    {
      "id": "D1",
      "kind": "never",
      "status": "established",
      "statement": "The same state and message produce two different decisions.",
      "package": "github.com/anyweez/cairn/spectest"
    },
    {
      "id": "D2",
      "kind": "never",
      "status": "established",
      "statement": "Decide or Evolve panics.",
      "package": "github.com/anyweez/cairn/spectest"
    },
    {
      "id": "D3",
      "kind": "never",
      "status": "established",
      "statement": "A refused decision carries events or effects.",
      "package": "github.com/anyweez/cairn/spectest"
    },
    {
      "id": "D4",
      "kind": "never",
      "status": "established",
      "statement": "Decide or Evolve modifies the state it was given.",
      "package": "github.com/anyweez/cairn/spectest"
    },
    {
      "id": "D5",
      "kind": "never",
      "status": "established",
      "statement": "Folding a run's events from the initial state ends anywhere but where the run did.",
      "package": "github.com/anyweez/cairn/spectest"
    },
    {
      "id": "D6",
      "kind": "never",
      "status": "established",
      "statement": "A message, event or effect does not survive encoding and decoding unchanged.",
      "package": "github.com/anyweez/cairn/spectest"
    },
    {
      "id": "D7",
      "kind": "never",
      "status": "established",
      "statement": "A state does not survive a JSON snapshot round trip unchanged.",
      "package": "github.com/anyweez/cairn/spectest"
    },
    {
      "id": "DR1",
      "kind": "never",
      "status": "established",
      "statement": "A decision's status changes other than along an edge of Lifecycle.",
      "package": "github.com/anyweez/cairn/examples/decisions"
    },
    {
      "id": "DR2",
      "kind": "never",
      "status": "established",
      "statement": "A decided or superseded decision lacks a complete outcome, or any other decision has one.",
      "package": "github.com/anyweez/cairn/examples/decisions"
    },
    {
      "id": "DR3",
      "kind": "never",
      "status": "established",
      "statement": "A superseded decision does not name another decision as its replacement, or any other decision does.",
      "package": "github.com/anyweez/cairn/examples/decisions"
    },
    {
      "id": "DR4",
      "kind": "never",
      "status": "established",
      "statement": "A position or an outcome names an option the decision does not have.",
      "package": "github.com/anyweez/cairn/examples/decisions"
    },
    {
      "id": "DR5",
      "kind": "never",
      "status": "established",
      "statement": "Options or positions change while the decision is not open.",
      "package": "github.com/anyweez/cairn/examples/decisions"
    },
    {
      "id": "DR6",
      "kind": "never",
      "status": "established",
      "statement": "A recorded outcome changes in place rather than being cleared by a reopen.",
      "package": "github.com/anyweez/cairn/examples/decisions"
    },
    {
      "id": "DR7",
      "kind": "never",
      "status": "established",
      "statement": "Reopening a settled decision leaves any member's answer to the old outcome in place.",
      "package": "github.com/anyweez/cairn/examples/decisions"
    },
    {
      "id": "DR8",
      "kind": "never",
      "status": "proposed",
      "statement": "A member whose position endorsed the chosen option records a disagree-and-commit answer.",
      "package": "github.com/anyweez/cairn/examples/decisions"
    }
  ],
  "codecs": [
